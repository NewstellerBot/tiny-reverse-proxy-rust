FROM rust:1-bookworm AS builder

WORKDIR /workspace
COPY . .
RUN cargo build --release -p tiny-reverse-proxy --features plugin-llm-gateway --bin tiny-reverse-proxy

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/tiny-reverse-proxy /usr/local/bin/tiny-reverse-proxy

ENTRYPOINT ["tiny-reverse-proxy"]
