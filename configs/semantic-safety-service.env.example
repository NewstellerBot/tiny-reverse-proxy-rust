# Build the service with:
# cargo build -p semantic-safety-service --release --features native-tensorrt
# Set the *_INCLUDE and *_LIB build env vars if TensorRT/CUDA are not installed
# in standard system locations.
SEMANTIC_SAFETY_ADDR=127.0.0.1:50061
SEMANTIC_SAFETY_AUTH_TOKEN=replace-me
SEMANTIC_SAFETY_DATA_DIR=./semantic-safety-data
SEMANTIC_SAFETY_EMBEDDING_ENGINE=/opt/semantic-safety/engines/embedding.engine
SEMANTIC_SAFETY_RERANKER_ENGINE=/opt/semantic-safety/engines/reranker.engine
SEMANTIC_SAFETY_TOKENIZER_DIR=/opt/semantic-safety/tokenizer
SEMANTIC_SAFETY_DEVICE_ID=0
SEMANTIC_SAFETY_MAX_BATCH_SIZE=8
SEMANTIC_SAFETY_MAX_SEQUENCE_LENGTH=512
SEMANTIC_SAFETY_WARMUP_ENABLED=true
SEMANTIC_SAFETY_METRICS_ADDR=127.0.0.1:9465
