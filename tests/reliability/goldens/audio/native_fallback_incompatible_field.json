{
  "scenario_id": "audio_native_fallback_incompatible_field",
  "request": {
    "method": "POST",
    "path": "/v1/audio/speech",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "model": "gpt-4o-mini-tts",
      "input": "Hello natively",
      "voice": "alloy",
      "speed": 1.1
    }
  },
  "provider_context": {
    "family": "openrouter",
    "surfaced_protocol": "openai_audio",
    "request_mode": "native_fallback"
  },
  "upstream_response": {
    "status": 200,
    "headers": {
      "content-type": "audio/mpeg"
    },
    "body": "native-audio"
  },
  "expected_upstream": {
    "path": "/v1/audio/speech",
    "body_contains": [
      "\"speed\":1.1",
      "\"voice\":\"alloy\""
    ]
  },
  "expected_client": {
    "status": 200,
    "body_contains": [
      "native-audio"
    ]
  }
}
